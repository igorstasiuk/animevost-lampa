{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run lampa:source)",
      "Bash(node --check animevost.js)",
      "Bash(sh tools/lampa-source.sh)",
      "Bash(sh tools/lampa-grep.sh:*)",
      "Bash(python3 release.py --check)",
      "Bash(python3 release.py * --dry-run)"
    ],
    "ask": [
      "Bash(python3 release.py:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-syntax.js\""
          }
        ]
      }
    ]
  }
}
